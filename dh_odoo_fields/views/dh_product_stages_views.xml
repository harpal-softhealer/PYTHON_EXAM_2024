<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dh_product_stages_view_form" model="ir.ui.view">
        <field name="name">dh.product.stages.view.form</field>
        <field name="model">dh.product.stages</field>
        <field name="arch" type="xml">
            <form string="Product Stage">
                <sheet>
                    <group>
                        <field name="name"></field>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"></widget>
                        <field name="active" invisible="1"></field>
                        <field name="priority" widget="priority"></field>
                        <field name="description"  invisible="0"></field>
                        
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dh_product_stages_view_tree" model="ir.ui.view">
        <field name="name">dh.product.stages.view.tree</field>
        <field name="model">dh.product.stages</field>
        <field name="arch" type="xml">
            <list string="Product Stage" >
                <field name="name"></field>
            </list>
        </field>
    </record>


    <record id="dh_product_stages_action" model="ir.actions.act_window">
        <field name="name">Product Stage</field>
        <field name="res_model">dh.product.stages</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="dh_product_stages_menu"
        name="Product Stage"
        action="dh_product_stages_action"
        parent="sale.product_menu_catalog"
        sequence="10"/>

    

</odoo>
