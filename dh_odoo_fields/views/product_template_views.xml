<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dh_odoo_fields_product_template_view_form_inherit" model="ir.ui.view">
        <field name="name">product.template.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"></field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                    <field name="sh_product_status" widget="statusbar" options="{'clickable' : '1'}"></field>
            </xpath>
        </field>
    </record>

</odoo>
